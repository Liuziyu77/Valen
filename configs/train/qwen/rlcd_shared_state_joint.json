{
  "config_version": 2,
  "model": {
    "architecture": "qwen",
    "model_path": "models/Qwen3.5-2B",
    "qwen_execution": "shared_state",
    "dtype": "bf16",
    "attn_implementation": "flash_attention_2",
    "head_type": "mixer",
    "head_width": 256,
    "head_layers": 2,
    "head_token_hidden_dim": 16,
    "head_channel_hidden_dim": 1024
  },
  "data": {
    "path": "data/smoke/train.jsonl",
    "max_length": 8192,
    "media_kwargs": {
      "videos_kwargs": {
        "num_frames": 16,
        "fps": null
      }
    }
  },
  "training": {
    "output": "output/qwen-shared-state/rlcd",
    "stage": "joint",
    "device": "cuda",
    "seed": 42,
    "epochs": 1,
    "max_steps": 100,
    "tokens_per_step": 32768,
    "microbatch_size": 8,
    "microbatch_max_tokens": 65536,
    "data_prefetch": true,
    "loss_reduction": "question_mean",
    "gradient_checkpointing": true,
    "head_lr": 2e-05,
    "lora_rank": 32,
    "lora_alpha": 64,
    "lora_lr": 2e-06,
    "merger_lr": 1e-06,
    "save_every": 10
  },
  "objective": {
    "method": "rlcd",
    "rps_weight": 0.0,
    "rlcd": {
      "group_size": 16,
      "num_iterations": 2,
      "correctness_weight": 1.0,
      "confidence_weight": 1.0,
      "brier_weight": 1.0,
      "beta": 0.02,
      "clip_epsilon": 0.2,
      "advantage_epsilon": 1e-06
    }
  }
}
