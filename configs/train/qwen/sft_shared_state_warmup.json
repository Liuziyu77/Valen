{
  "config_version": 2,
  "model": {
    "architecture": "qwen",
    "model_path": "models/Qwen3.5-2B",
    "qwen_execution": "shared_state",
    "dtype": "bf16",
    "attn_implementation": "flash_attention_2",
    "head_type": "mixer",
    "head_width": 256,
    "head_layers": 2,
    "head_token_hidden_dim": 16,
    "head_channel_hidden_dim": 1024
  },
  "data": {
    "path": "data/smoke/train.jsonl",
    "max_length": 8192,
    "media_kwargs": {"videos_kwargs": {"num_frames": 16, "fps": null}}
  },
  "training": {
    "output": "output/qwen-shared-state/warmup",
    "stage": "warmup",
    "device": "cuda",
    "seed": 42,
    "epochs": 1,
    "max_steps": 100,
    "tokens_per_step": 32768,
    "microbatch_size": 8,
    "microbatch_max_tokens": 65536,
    "data_prefetch": true,
    "loss_reduction": "question_mean",
    "gradient_checkpointing": false,
    "head_lr": 0.0002,
    "save_every": 10
  },
  "objective": {"rps_weight": 0.2, "brier_weight": 0.1}
}
