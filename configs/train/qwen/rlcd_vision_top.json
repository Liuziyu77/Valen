{
  "config_version": 2,
  "model": {
    "architecture": "qwen",
    "model_path": "models/Qwen3.5-2B",
    "dtype": "bf16",
    "projection_dim": 256
  },
  "data": {
    "path": "data/smoke/train.jsonl",
    "max_length": 8192
  },
  "training": {
    "output": "output/rlcd_vision_top",
    "stage": "vision_top",
    "device": "cuda",
    "seed": 42,
    "epochs": 3,
    "max_steps": 100,
    "tokens_per_step": 16384,
    "gradient_checkpointing": true,
    "lora_rank": 32,
    "lora_alpha": 64,
    "lora_lr": 5e-05,
    "merger_lr": 1e-05,
    "head_lr": 1e-05,
    "vision_lr": 2e-06,
    "save_every": 10
  },
  "objective": {
    "rps_weight": 0.0,
    "method": "rlcd",
    "rlcd": {
      "group_size": 16,
      "num_iterations": 2,
      "correctness_weight": 1.0,
      "confidence_weight": 1.0,
      "brier_weight": 1.0,
      "beta": 0.02,
      "clip_epsilon": 0.2,
      "advantage_epsilon": 1e-06
    }
  }
}
