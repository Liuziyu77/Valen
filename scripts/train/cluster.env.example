# Copy to .env.cluster at the repository root and fill in your cluster settings.
# Environment overrides take precedence with this assignment style.
export RJOB_BIN="${RJOB_BIN:-rjob}"
export RJOB_NAMESPACE="${RJOB_NAMESPACE:-your-namespace}"
export RJOB_CHARGED_GROUP="${RJOB_CHARGED_GROUP:-your-quota-group}"
export RJOB_IMAGE="${RJOB_IMAGE:-your-registry/pytorch-cuda:tag}"
export RJOB_PRIVATE_MACHINE="${RJOB_PRIVATE_MACHINE:-group}"

# Use your scheduler's mount syntax; keep the repository and data accessible
# at the same paths on both the submit host and the worker.
export RJOB_MOUNTS="${RJOB_MOUNTS:-}"
export RJOB_CAPTION_MOUNT="${RJOB_CAPTION_MOUNT:-}"
# export VALEN_PYTHON="/workspace/Valen/.venv/bin/python"
# export VALEN_CAPTION_SOURCE_ROOT="/datasets/caption-indices"
# export VALEN_CAPTION_ROOT="data"
# export VALEN_CREDENTIALS_CONFIG="$HOME/petreloss.conf"
